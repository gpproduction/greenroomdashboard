# Copy to .env and fill in. Everything here can also be set in Admin → Settings instead.
PORT=8080
# Initial admin password (only used if no password has been set yet)
ADMIN_PASSWORD=
# Planning Center Personal Access Token (https://api.planningcenteronline.com/oauth/applications)
PCO_APP_ID=
PCO_SECRET=
# Set to 1 to run with sample data (no Planning Center / ProPresenter needed)
DEMO=0
